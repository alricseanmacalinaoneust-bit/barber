# Copy this file to .env and fill in your own values. Never share .env.

# Database: local MongoDB, or your MongoDB Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=barbershop

PORT=3000
# The shop's time zone: the queue resets at local midnight.
TZ=Asia/Manila

# A long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Used by "npm run seed" to create the admin and (optional) cashier accounts.
ADMIN_NAME=Barbershop Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
CASHIER_NAME=Front Desk Cashier
CASHIER_EMAIL=
CASHIER_PASSWORD=

# Email for admin login codes. While SMTP_USER/SMTP_PASS are empty, codes are
# printed in the server window instead (local testing only).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
